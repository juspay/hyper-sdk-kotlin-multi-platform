# Copy to sample/sandbox-credentials.properties (gitignored) and fill in your Juspay sandbox merchant.
# clientId also selects the Android samples' assets; for iOS, set it in the samples' MerchantConfig files.
# merchantId defaults to clientId. Without a key the payloads go out unsigned: the SDK boots, but a
# payment can't complete. privateKey is the base64 DER body of the RSA key, without PEM header lines.
clientId=geddit
merchantId=
merchantKeyId=
privateKey=
